<UserControl x:Class="QFTPlus.LogViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:QFTPlus" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
   <ui:CardExpander x:Name="LogExpander" Expanded="RefreshLog" Header="{local:Loc Diagnostics}" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock x:Name="LogLabel" Text="{local:Loc Log}" Margin="0,0,0,8"/>
     <ComboBox x:Name="LogPicker" SelectionChanged="SelectLog" Margin="0,0,0,8" AutomationProperties.Name="{local:Loc Log}" AutomationProperties.LabeledBy="{Binding ElementName=LogLabel}"/>
     <TextBlock x:Name="LogCaption" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
     <TextBox x:Name="LogText" IsReadOnly="True" IsUndoEnabled="False" IsReadOnlyCaretVisible="True" Height="300" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource Font12}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Loc LogContents}"/>
     <WrapPanel Margin="0,12,0,0">
      <Button x:Name="CopyLogButton" Click="CopyLog" Content="{local:Loc CopyLog}" Margin="0,0,8,8"/>
      <Button x:Name="OpenLogButton" Click="OpenLog" Content="{local:Loc OpenInEditor}" Margin="0,0,8,8"/>
      <Button x:Name="RecordingsButton" Click="OpenRecordings" Content="{local:Loc OpenRecordings}" Margin="0,0,8,8"/>
     </WrapPanel>
    </StackPanel>
   </ui:CardExpander>
</UserControl>
