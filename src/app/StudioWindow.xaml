       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsTester}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="Record a short session and send it to the QFT+ developer. Recordings from many different faces make tracking better for everyone." FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
        <Expander Header="What’s shared" IsExpanded="True" Margin="0,8,0,0">
         <StackPanel>
          <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{DynamicResource Font13}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,8"/></Style></StackPanel.Resources>
          <TextBlock Text="• Small infrared images of your eyes, brows and mouth from the headset’s face cameras, and the expression values the headset reports."/>
          <TextBlock Text="• No audio, no color camera, and no name or account. Each recording carries a random tester ID instead."/>
          <TextBlock Text="• Recordings are used only to test and improve QFT+ face tracking."/>
          <TextBlock Text="• Nothing is sent automatically. You send recordings yourself, directly to the developer."/>
          <TextBlock Text="• You can ask for your recordings to be deleted at any time with your tester ID."/>
         </StackPanel>
        </Expander>
        <CheckBox x:Name="TesterConsent" Style="{StaticResource Agreement}" Content="I agree to share the recordings I send" Margin="0,8,0,0"/>
        <ui:Button Content="Become a tester" Click="JoinTesting" IsEnabled="{Binding IsChecked, ElementName=TesterConsent}" Appearance="Primary" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </StackPanel>
     </ui:Card>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <WrapPanel x:Name="Actions" Grid.Row="3" Margin="0,16,0,0">
    <ui:Button x:Name="setUpFace" Content="Set up face" Click="SetUpFaceFirst" Appearance="Primary" Margin="0,0,8,0"/>
    <ui:Button x:Name="begin" Content="Start calibration" Click="BeginCalibration" Appearance="Primary"/>
    <Button x:Name="pause" Content="Pause" Tag="pause" Click="GuideCommand"/>
    <Button x:Name="skip" Content="Skip pose" Tag="skip" Click="GuideCommand" Margin="8,0,0,0"/>
    <Button x:Name="cancel" Content="Cancel" Click="CancelCalibration" Margin="12,0,0,0"/>
    <Button x:Name="review" Content="Review video" Click="ReviewCalibration" Margin="12,0,0,0"/>
   </WrapPanel>
  </Grid>
  <ui:TitleBar Grid.ColumnSpan="2" Height="40" Title="" ShowHelp="False" Background="Transparent" ButtonsForeground="{DynamicResource Ink}"/>
 </Grid>
</ui:FluentWindow>
