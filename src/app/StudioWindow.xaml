       <StackPanel x:Name="TrackingCard">
       <DockPanel MinHeight="44">
        <CheckBox x:Name="TrackingSwitch" DockPanel.Dock="Right" Click="TrackingSwitchClick" AutomationProperties.Name="{local:Loc Tracking}" HorizontalAlignment="Right" Margin="16,0,0,0"/>
        <ui:Button x:Name="TrackingAction" DockPanel.Dock="Right" Click="TrackingActionClick" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <StackPanel VerticalAlignment="Center">
         <TextBlock x:Name="TrackingTitle" FontSize="{DynamicResource Font16}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock x:Name="TrackingMessage" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
       </DockPanel>
       <ProgressBar x:Name="TrackingProgress" Margin="0,8,0,4" Visibility="Collapsed"/>
       </StackPanel>
      </ui:Card>
      <WrapPanel Margin="0,12,0,0">
       <Button x:Name="ViewCamerasButton" Content="{local:Loc ViewCameras}" Click="ViewCameras" Margin="0,0,8,8"/>
       <Button x:Name="TrackingHelp" Click="HelpClick" Margin="0,0,8,8"/>
       <Button x:Name="TrackingLogs" Content="{local:Loc ViewLogs}" Click="ViewTrackingLog" Margin="0,0,8,8"/>
      </WrapPanel>
     </StackPanel>
     <TextBlock x:Name="CalibrationAreaLabel" Text="{local:Loc TrackingArea}" Margin="0,0,0,8"/>
     <ComboBox x:Name="calibrationModes" Margin="0,0,0,16" AutomationProperties.Name="{local:Loc TrackingArea}" AutomationProperties.LabeledBy="{Binding ElementName=CalibrationAreaLabel}"/>
     <ui:Card x:Name="CalibrationCard">
      <StackPanel x:Name="CalibrationGuide">
       <TextBlock x:Name="poseTitle" FontSize="{DynamicResource Font23}" TextAlignment="Center" Margin="0,0,0,8"/>
       <TextBlock x:Name="poseDetail" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,0,0,8"/>
       <TextBlock x:Name="cue" FontSize="{DynamicResource Font25}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"/>
       <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><local:FaceGuide x:Name="face" Width="360" Height="250" Foreground="{DynamicResource Ink}" Focusable="False"/></Viewbox>
       <ProgressBar x:Name="progress" Margin="0,16,0,10"/>
       <TextBlock x:Name="count" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,0,0,8"/>
      </StackPanel>
     </ui:Card>
     <StackPanel x:Name="CalibrationResultPanel">
      <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionHeading}" FontSize="{DynamicResource Font23}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ResultDetail" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <TextBlock x:Name="ResultError" FontSize="{DynamicResource Font14}" Margin="0,0,0,8"/>
      <StackPanel x:Name="ResultDetailsHost">
       <Expander x:Name="ResultFindings" MinHeight="44" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
        <Expander.Header><TextBlock Text="{local:Loc WhatNeedsAttention}" FontSize="{DynamicResource Font14}" TextWrapping="Wrap"/></Expander.Header>
        <ItemsControl x:Name="ResultLines" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="{DynamicResource Font14}" TextWrapping="Wrap" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </Expander>
      </StackPanel>
      <WrapPanel x:Name="ResultFiles" Margin="0,12,0,0">
       <ui:Button Content="{local:Loc ShowFile}" Click="ShowBenchmarkFile" Appearance="Primary" Margin="0,0,8,8"/>
       <Button Content="{local:Loc MessageOnDiscord}" Click="MessageOnDiscord" Margin="0,0,8,8"/>
      </WrapPanel>
     </StackPanel>
     <CheckBox x:Name="slowMode" Content="{local:Loc MoreTimeForEachPose}" Click="SlowModeClick" Margin="0,12,0,0"/>
     <ui:Card x:Name="FaceCalibrationOptions">
      <StackPanel>
       <TextBlock Text="{local:Loc FaceCalibration}" Style="{StaticResource SectionHeading}" FontSize="{DynamicResource Font16}" Margin="0,0,0,8"/>
       <TextBlock Text="{local:Loc CheeksTongueAndBrowsWorkWithoutCalibrationCalibratingYour}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
       <CheckBox x:Name="FaceLogCheck" Content="{local:Loc SaveFaceTrackingLogsOnThisPCNumbersOnly}" Click="FaceLogClick" Margin="0,8,0,0"/>
      </StackPanel>
     </ui:Card>
     <ui:Card x:Name="testerCard">
      <StackPanel>
       <TextBlock Text="{local:Loc HelpImproveTracking}" Style="{StaticResource SectionHeading}" FontSize="{DynamicResource Font16}" Margin="0,0,0,8"/>
       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTester}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{Binding Id, StringFormat=You’re a tester. Your tester ID is {0}.}" AutomationProperties.Name="{Binding Id, StringFormat=Tester ID {0}}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
        <TextBlock Text="{local:Loc RecordABenchmarkThenSendTheFileItMakes}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,8,0,0">
         <ui:Button Content="{local:Loc RecordABenchmark}" Click="RecordBenchmark" Appearance="Primary" Margin="0,0,8,8"/>
         <Button Content="{local:Loc MessageOnDiscord}" Click="MessageOnDiscord" Margin="0,0,8,8"/>
         <Button Content="{local:Loc StopBeingATester}" Click="LeaveTesting" AutomationProperties.HelpText="{local:Loc BenchmarkIsRemovedFromCalibrationRecordingsAlreadyOnThis}" Margin="0,0,8,8"/>
        </WrapPanel>
       </StackPanel>
       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsTester}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{local:Loc RecordAShortSessionAndSendItToThe}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
        <Expander Header="{local:Loc WhatSShared}" IsExpanded="True" Margin="0,8,0,0">
         <StackPanel>
          <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{DynamicResource Font13}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,0,0,8"/></Style></StackPanel.Resources>
          <TextBlock Text="{local:Loc SmallInfraredImagesOfYourEyesBrowsAndMouth}"/>
          <TextBlock Text="{local:Loc NoAudioNoColorCameraAndNoNameOr}"/>
          <TextBlock Text="{local:Loc RecordingsAreUsedOnlyToTestAndImproveQFT}"/>
          <TextBlock Text="{local:Loc NothingIsSentAutomaticallyYouSendRecordingsYourselfDirectly}"/>
          <TextBlock Text="{local:Loc YouCanAskForYourRecordingsToBeDeleted}"/>
         </StackPanel>
        </Expander>
        <CheckBox x:Name="TesterConsent" Style="{StaticResource Agreement}" Content="{local:Loc IAgreeToShareTheRecordingsISend}" Margin="0,8,0,0"/>
        <ui:Button Content="{local:Loc BecomeATester}" Click="JoinTesting" IsEnabled="{Binding IsChecked, ElementName=TesterConsent}" Appearance="Primary" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </StackPanel>
     </ui:Card>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <WrapPanel x:Name="Actions" Grid.Row="3" Margin="0,16,0,0">
    <ui:Button x:Name="setUpFace" Content="{local:Loc SetUpFace}" Click="SetUpFaceFirst" Appearance="Primary" Margin="0,0,8,0"/>
    <ui:Button x:Name="begin" Content="{local:Loc StartCalibration}" Click="BeginCalibration" Appearance="Primary"/>
    <Button x:Name="pause" Content="{local:Loc Pause}" Tag="pause" Click="GuideCommand"/>
    <Button x:Name="skip" Content="{local:Loc SkipPose}" Tag="skip" Click="GuideCommand" Margin="8,0,0,0"/>
    <Button x:Name="cancel" Content="{local:Loc Cancel}" Click="CancelCalibration" Margin="12,0,0,0"/>
    <Button x:Name="review" Content="{local:Loc ReviewVideo}" Click="ReviewCalibration" Margin="12,0,0,0"/>
   </WrapPanel>
  </Grid>
  <Grid x:Name="Onboarding" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
   <Border x:Name="OnboardingScrim" Background="#73000000"/>
   <Border x:Name="OnboardingCard" Width="560" Margin="24,40,24,16" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="24" Background="{DynamicResource Menu}" BorderBrush="{DynamicResource MenuLine}" BorderThickness="1" KeyboardNavigation.TabNavigation="Cycle" RenderTransformOrigin=".5,.5">
    <Border.Effect><DropShadowEffect BlurRadius="48" ShadowDepth="16" Direction="270" Opacity=".5"/></Border.Effect>
    <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
    <DockPanel>
     <Grid DockPanel.Dock="Top" Height="210">
      <Border x:Name="OnboardingHero" CornerRadius="23,23,0,0" Background="{DynamicResource Canvas}"/>
      <ui:Button x:Name="OnboardingBack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Width="44" Height="44" Padding="0" CornerRadius="22" Appearance="Secondary" Click="OnboardingBackClick" AutomationProperties.Name="{local:Loc Back}"/>
     </Grid>
     <StackPanel DockPanel.Dock="Bottom" Margin="44,16,44,28">
      <ContentControl x:Name="OnboardingPrimary" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch"/>
      <ui:Button x:Name="OnboardingSecondary" Appearance="Transparent" BorderThickness="0" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnboardingSecondaryClick"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel x:Name="OnboardingContent" Margin="44,24,44,12">
       <UniformGrid x:Name="OnboardingSteps" Rows="1" Height="4" Margin="0,0,0,24" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="OnboardingTitle" FontSize="{DynamicResource Font25}" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,10"/>
       <TextBlock x:Name="OnboardingAbout" FontSize="{DynamicResource Font14}" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,0,0,24"/>
       <ContentControl x:Name="OnboardingBody" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <ui:TitleBar Grid.Column="1" Height="40" Title="" ShowHelp="False" Background="Transparent" ButtonsForeground="{DynamicResource Ink}"/>
 </Grid>
</ui:FluentWindow>
