<UserControl x:Class="QFTPlus.ThumbrestSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:QFTPlus" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="{local:Loc ThumbrestAndTrigger}" FontWeight="SemiBold" FontSize="{DynamicResource Font16}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,8"/>
  <TextBlock Text="{local:Loc HowTheQuestProControllersThumbrestsActInSteamVR}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <Button x:Name="Driver" Click="ToggleDriver" HorizontalAlignment="Left" Margin="0,12,0,8" AutomationProperties.HelpText="{local:Loc TheQFTDriverAddsTheThumbrestTrackpadAndTrigger}"/>
  <StackPanel x:Name="Options">
   <TextBlock x:Name="ModeLabel" Text="{local:Loc ThumbrestMode}" Margin="0,0,0,8"/>
   <ComboBox x:Name="Mode" DisplayMemberPath="Title" SelectedValuePath="Id" AutomationProperties.Name="{local:Loc ThumbrestMode}" AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}"/>
   <TextBlock Text="{Binding SelectedItem.About, ElementName=Mode}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
   <StackPanel x:Name="Angles"/>
   <TextBlock Text="{local:Loc TurnUntilAStraightUpAndDownSwipeReads}" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <StackPanel x:Name="Sensitivity"/>
   <CheckBox x:Name="Resting" Content="{local:Loc IgnoreARestingThumb}" Tag="restingSize" Click="ToggleOption" Margin="0,0,0,8"/>
   <CheckBox x:Name="Straighten" Content="{local:Loc StraightenScrolling}" Tag="railAngle" Click="ToggleOption" Margin="0,0,0,16"/>
   <CheckBox x:Name="Reversed" Content="{local:Loc ReverseTriggerSlideNormallySlidingTowardTheTipIs}" Tag="triggerSlideReversed" Click="ToggleOption" Margin="0,0,0,16"/>
   <StackPanel x:Name="Joystick"/>
   <StackPanel x:Name="Swipe"/>
   <StackPanel x:Name="Mouse"/>
  </StackPanel>
  <TextBlock x:Name="Status" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
