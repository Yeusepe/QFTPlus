<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QproFaceTracking.Setup</AssemblyName>
    <Product>QFT+</Product><Title>QFT+ Setup</Title><Description>Install QFT+</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(Payload)' != ''">
    <EmbeddedResource Include="$(Payload)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
